#!/bin/sh
# Pre-push hook: block the push if the list fails awesome-lint or the house-style check.
#
# Activate (once per clone):  git config core.hooksPath .githooks
# awesome-lint checks structure, alphabetical order, format, and repo metadata.
# style-check.sh checks the mechanically decidable house-style rules (naming canon,
# length ceiling, punctuation, self-repetition); its warnings do not block.
# Note: neither asks whether an entry is still reachable or still true. Those are the
# weekly maintenance workflow's job (link-check.sh and entry-drift.sh), because both
# need a network round-trip per entry and neither should stand between you and a push.

echo "pre-push: running awesome-lint…"
if ! npx --yes awesome-lint; then
	echo "✗ awesome-lint failed — push blocked. Fix the issues above, then push again." >&2
	exit 1
fi
echo "✓ awesome-lint passed."

echo "pre-push: running house-style check…"
if ! bash .github/scripts/style-check.sh README.md; then
	echo "✗ style-check failed — push blocked. Fix the ERRORs above, then push again." >&2
	exit 1
fi
echo "✓ style-check passed — pushing."
exit 0
